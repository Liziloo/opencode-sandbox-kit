{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/bash",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "formatter": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "oauth": false,
      "headers": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 15000
  },
  "experimental": {
  "policies": [
      { "effect": "deny", "action": "provider.use", "resource": "*" },
      { "effect": "allow", "action": "provider.use", "resource": "openrouter" },
      { "effect": "allow", "action": "provider.use", "resource": "ollama" }
    ]
  },
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://192.168.2.86:11434/v1"
      }
    }
  },
  "subagent_depth": 1,
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {"disable": true},
    "explore": {"disable": true},
    "general": {"disable": true},
    "architect": {
      "mode": "primary",
      "prompt": "{file:agents/architect.md}",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "test-writer", "effect": "allow" },
        { "action": "subagent", "resource": "implementer", "effect": "allow" },
        { "action": "subagent", "resource": "reviewer", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "test-writer": {
      "mode": "all",
      "prompt": "{file:agents/test-writer.md}",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "backend/tests/**", "effect": "allow" },
        { "action": "edit", "resource": "frontend/tests/**", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "implementer": {
      "mode": "all",
      "prompt": "{file:agents/implementer.md}",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "backend/**", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "frontend/**", "effect": "allow" },
        { "action": "edit", "resource": "backend/tests/**", "effect": "deny" },
        { "action": "edit", "resource": "frontend/tests/**", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "reviewer": {
      "mode": "all",
      "prompt": "{file:agents/reviewer.md}",
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
