{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/bash",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "formatter": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "oauth": false,
      "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "oauth": false,
      "headers": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 15000
  },
  "experimental": {
  "policies": [
      { "effect": "deny", "action": "provider.use", "resource": "*" },
      { "effect": "allow", "action": "provider.use", "resource": "openrouter" },
      { "effect": "allow", "action": "provider.use", "resource": "ollama" }
    ]
  },
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "{env:OLLAMA_HOST}/v1"
      }
    }
  },
  "subagent_depth": 1,
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },

    "architect": {
      "mode": "primary",
      "prompt": "{file:agents/architect.md}",
      "permission": {
        "question": "allow",
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "git status": "allow",
          "git status *": "allow",
          "git diff": "allow",
          "git diff *": "allow",
          "git log": "allow",
          "git log *": "allow",
          "git show": "allow",
          "git show *": "allow"
        },
        "edit": "deny",
        "write": "deny",
        "task": {
          "*": "deny",
          "test-writer": "allow",
          "implementer": "allow",
          "reviewer": "allow"
        }
      }
    },

    "test-writer": {
      "mode": "all",
      "prompt": "{file:agents/test-writer.md}",
      "permission": {
        "question": "allow",
        "bash": "allow",
        "edit": {
          "*": "deny",
          "backend/tests/**": "allow",
          "frontend/tests/**": "allow"
        },
        "write": {
          "*": "deny",
          "backend/tests/**": "allow",
          "frontend/tests/**": "allow"
        },
        "task": "deny"
      }
    },

    "implementer": {
      "mode": "all",
      "prompt": "{file:agents/implementer.md}",
      "permission": {
        "question": "allow",
        "bash": "allow",
        "edit": {
          "*": "allow",
          "backend/tests/**": "deny",
          "frontend/tests/**": "deny"
        },
        "write": {
          "*": "allow",
          "backend/tests/**": "deny",
          "frontend/tests/**": "deny"
        },
        "task": "deny"
      }
    },

    "reviewer": {
      "mode": "all",
      "prompt": "{file:agents/reviewer.md}",
      "permission": {
        "question": "allow",
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "git status": "allow",
          "git status *": "allow",
          "uv run pytest": "allow",
          "uv run pytest *": "allow"
        },
        "edit": "deny",
        "write": "deny",
        "task": "deny"
      }
    }
  }
}
